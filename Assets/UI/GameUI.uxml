<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="GameOverPanel" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.816); align-items: center; justify-content: space-around; font-size: 30px; -unity-text-align: upper-center;">
        <ui:Label text="Game Over" name="GameOverMessage" parse-escape-sequences="false" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 0, 0); -unity-text-align: upper-center; font-size: 40px;"/>
        <ui:Label text="Survived for 5 days" name="HowManyDaysMessage" parse-escape-sequences="false" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 0, 0); -unity-text-align: upper-center; font-size: 20px; bottom: 400px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="backgroundBar" style="flex-grow: 1; background-color: rgb(0, 0, 0); background-size: 100% 100%; height: 30px; width: 100%; position: absolute; bottom: 0; left: 0; right: 0;">
        <ui:Label text="food:999" name="FoodLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center; position: absolute; bottom: 0; left: 150px; right: 70px;"/>
        <ui:Label text="Day : 0" name="DayLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center; position: absolute; bottom: 0; left: 0; right: 300px;"/>
        <ui:Label text="Day : 0" name="ZombiesLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center; position: absolute; bottom: 0; left: 500px; right: 0;"/>
    </ui:VisualElement>
</ui:UXML>
